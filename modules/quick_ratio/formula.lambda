LAMBDA(current_assets, inventory, current_liabilities,
  IF(NOT(AND(ISNUMBER(current_assets), ISNUMBER(inventory), ISNUMBER(current_liabilities))), #VALUE!,
  IF(OR(current_assets < 0, inventory < 0, inventory > current_assets, current_liabilities <= 0), #NUM!,
  (current_assets - inventory) / current_liabilities)))
